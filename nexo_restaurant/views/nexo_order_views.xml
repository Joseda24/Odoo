<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_restaurant_order_list" model="ir.ui.view">
    <field name="name">nexo.restaurant.order.list</field>
    <field name="model">nexo.restaurant.order</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="table_id"/>
        <field name="waiter_id"/>
        <field name="state" widget="badge"/>
        <field name="amount_total" sum="Total"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_restaurant_order_form" model="ir.ui.view">
    <field name="name">nexo.restaurant.order.form</field>
    <field name="model">nexo.restaurant.order</field>
    <field name="arch" type="xml">
      <form>
        <field name="state" widget="statusbar"/>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="table_id"/>
              <field name="waiter_id"/>
            </group>
            <group>
              <field name="amount_total" widget="monetary"/>
              <field name="amount_paid" widget="monetary"/>
              <field name="amount_due" widget="monetary"/>
            </group>
          </group>
          <notebook>
            <page string="Líneas">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="menu_item_id"/>
                  <field name="quantity"/>
                  <field name="price_unit" widget="monetary"/>
                  <field name="tax_percent"/>
                  <field name="price_subtotal" sum="Subtotal" widget="monetary"/>
                  <field name="state" widget="badge"/>
                  <field name="notes"/>
                </list>
              </field>
            </page>
            <page string="Pagos">
              <field name="payment_ids">
                <list>
                  <field name="payment_date"/>
                  <field name="method"/>
                  <field name="amount" widget="monetary"/>
                  <field name="reference"/>
                </list>
              </field>
            </page>
            <page string="Notas">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
