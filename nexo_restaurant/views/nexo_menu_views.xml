<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_menu_category_list" model="ir.ui.view">
    <field name="name">nexo.menu.category.list</field>
    <field name="model">nexo.menu.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="item_ids" invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_menu_category_form" model="ir.ui.view">
    <field name="name">nexo.menu.category.form</field>
    <field name="model">nexo.menu.category</field>
    <field name="arch" type="xml">
      <form>
        
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_nexo_menu_item_list" model="ir.ui.view">
    <field name="name">nexo.menu.item.list</field>
    <field name="model">nexo.menu.item</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="category_id"/>
        <field name="price" sum="Total"/>
        <field name="available" widget="boolean_toggle"/>
        <field name="preparation_time"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_menu_item_form" model="ir.ui.view">
    <field name="name">nexo.menu.item.form</field>
    <field name="model">nexo.menu.item</field>
    <field name="arch" type="xml">
      <form>
        
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="category_id"/>
              <field name="price" widget="monetary"/>
              <field name="cost" widget="monetary"/>
            </group>
            <group>
              <field name="available" widget="boolean_toggle"/>
              <field name="preparation_time"/>
            </group>
          </group>
          <field name="description"/>
          <field name="image" widget="image"/>
          <notebook>
            <page string="Receta">
              <field name="recipe_line_ids">
                <list editable="bottom">
                  <field name="ingredient_id"/>
                  <field name="quantity"/>
                  <field name="unit"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_nexo_menu_item_search" model="ir.ui.view">
    <field name="name">nexo.menu.item.search</field>
    <field name="model">nexo.menu.item</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="category_id"/>
      </search>
    </field>
  </record>
</odoo>
