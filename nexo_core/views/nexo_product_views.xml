<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_product_tree" model="ir.ui.view">
    <field name="name">nexo.product.tree</field>
    <field name="model">nexo.product</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="category_id"/>
        <field name="sale_price"/>
        <field name="type"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_product_form" model="ir.ui.view">
    <field name="name">nexo.product.form</field>
    <field name="model">nexo.product</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group string="General">
              <field name="code"/>
              <field name="barcode"/>
              <field name="category_id"/>
              <field name="type"/>
              <field name="uom_id"/>
            </group>
            <group string="Precios">
              <field name="sale_price"/>
              <field name="cost_price"/>
            </group>
          </group>
          <group string="Descripción">
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_nexo_product_search" model="ir.ui.view">
    <field name="name">nexo.product.search</field>
    <field name="model">nexo.product</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="barcode"/>
      </search>
    </field>
  </record>
</odoo>
