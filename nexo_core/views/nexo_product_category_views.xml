<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_product_category_tree" model="ir.ui.view">
    <field name="name">nexo.product.category.tree</field>
    <field name="model">nexo.product.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="parent_id"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_product_category_form" model="ir.ui.view">
    <field name="name">nexo.product.category.form</field>
    <field name="model">nexo.product.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="parent_id"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
