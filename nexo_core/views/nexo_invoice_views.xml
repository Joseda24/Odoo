<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_invoice_tree" model="ir.ui.view">
    <field name="name">nexo.invoice.tree</field>
    <field name="model">nexo.invoice</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="date_invoice"/>
        <field name="type"/>
        <field name="state" widget="badge"/>
        <field name="amount_total" sum="Total"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_invoice_form" model="ir.ui.view">
    <field name="name">nexo.invoice.form</field>
    <field name="model">nexo.invoice</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="partner_id"/>
            <field name="date_invoice"/>
            <field name="type"/>
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="product_id"/>
              <field name="description"/>
              <field name="quantity"/>
              <field name="price_unit"/>
              <field name="tax_percent"/>
              <field name="price_subtotal" sum="Subtotal"/>
            </list>
          </field>
          <group>
            <field name="amount_subtotal"/>
            <field name="amount_tax"/>
            <field name="amount_total"/>
          </group>
          <group string="Notas">
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
