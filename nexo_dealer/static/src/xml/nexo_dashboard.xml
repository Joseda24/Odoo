<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nexo_dealer.Dashboard" owl="1">
        <div class="o_nexo_dashboard">
            <t t-if="state.loading">
                <div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary mb-3"/>
                        <p class="text-muted">Cargando tablero...</p>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="container-fluid px-4 py-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0 fw-bold">
                            <i class="fa fa-tachometer me-2 text-primary"/>
                            Tablero del Concesionario
                        </h4>
                        <div class="d-flex gap-2 align-items-center">
                            <select class="form-select form-select-sm" style="width:auto;min-width:180px"
                                t-model="state.sel_salesperson" t-on-change="onFilterChange">
                                <option value="">Todos los vendedores</option>
                                <option t-foreach="state.data.filter_salespersons || []" t-as="sp" t-key="sp.id" t-att-value="sp.id">
                                    <t t-esc="sp.name"/>
                                </option>
                            </select>
                            <select class="form-select form-select-sm" style="width:auto"
                                t-model="state.sel_year" t-on-change="onFilterChange">
                                <option t-foreach="state.data.filter_years || []" t-as="y" t-key="y" t-att-value="y">
                                    <t t-esc="y"/>
                                </option>
                            </select>
                            <span class="badge bg-light text-dark border fs-6 px-3 py-2">
                                <t t-esc="state.data.currency"/> · Tiempo real
                            </span>
                        </div>
                    </div>

                    <!-- KPI Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm o_kpi_card h-100" t-on-click="openVehicles">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="kpi-icon bg-primary bg-opacity-10 text-primary rounded-3"><i class="fa fa-car fa-2x"/></div>
                                    <div>
                                        <span class="text-muted text-uppercase small fw-semibold">Vehículos</span>
                                        <h2 class="mt-1 mb-0 fw-bold"><t t-esc="state.data.total_vehicles"/></h2>
                                        <div class="small text-muted mt-1 d-flex gap-2 flex-wrap">
                                            <span><i class="fa fa-circle text-success me-1"/><t t-esc="state.data.vehicle_by_status.available"/></span>
                                            <span><i class="fa fa-circle text-danger me-1"/><t t-esc="state.data.vehicle_by_status.sold"/></span>
                                            <span><i class="fa fa-circle text-warning me-1"/><t t-esc="state.data.vehicle_by_status.reserved"/></span>
                                            <span><i class="fa fa-circle text-info me-1"/><t t-esc="state.data.vehicle_by_status.in_service"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm o_kpi_card h-100" t-on-click="openSaleOrders">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="kpi-icon bg-success bg-opacity-10 text-success rounded-3"><i class="fa fa-shopping-cart fa-2x"/></div>
                                    <div>
                                        <span class="text-muted text-uppercase small fw-semibold">Ventas</span>
                                        <h2 class="mt-1 mb-0 fw-bold"><t t-esc="state.data.total_sale_orders"/></h2>
                                        <div class="small text-muted mt-1"><t t-esc="state.data.confirmed_sales"/> conf. / <t t-esc="state.data.draft_quotations"/> cotiz.</div>
                                        <div class="small fw-bold text-success mt-1"><t t-esc="state.data.revenue_month"/> <t t-esc="state.data.currency"/> este mes</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm o_kpi_card h-100" t-on-click="openLeads">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="kpi-icon bg-warning bg-opacity-10 text-warning rounded-3"><i class="fa fa-users fa-2x"/></div>
                                    <div>
                                        <span class="text-muted text-uppercase small fw-semibold">Oportunidades</span>
                                        <h2 class="mt-1 mb-0 fw-bold"><t t-esc="state.data.total_leads"/></h2>
                                        <div class="small text-muted mt-1"><t t-esc="state.data.service_orders"/> servicios activos</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm o_kpi_card h-100" t-on-click="openPurchaseOrders">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="kpi-icon bg-info bg-opacity-10 text-info rounded-3"><i class="fa fa-truck fa-2x"/></div>
                                    <div>
                                        <span class="text-muted text-uppercase small fw-semibold">Compras</span>
                                        <h2 class="mt-1 mb-0 fw-bold"><t t-esc="state.data.total_purchase_orders"/></h2>
                                        <div class="small text-muted mt-1"><t t-esc="state.data.inventory_movements"/> mov. inventario</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Donut Charts Row (Vehicles, Leads, Financing) -->
                    <div class="row g-3 mb-4">
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-pie-chart text-primary me-1"/> Vehículos</h6>
                                </div>
                                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:220px">
                                    <canvas t-ref="chartVehicles" style="max-height:200px;width:100%"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-pie-chart text-warning me-1"/> Oportunidades</h6>
                                </div>
                                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:220px">
                                    <canvas t-ref="chartLeads" style="max-height:200px;width:100%"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-pie-chart text-success me-1"/> Financiamiento</h6>
                                </div>
                                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:220px">
                                    <canvas t-ref="chartFinancing" style="max-height:200px;width:100%"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2 Donut Charts Row (Commissions, Inventory) + Sales Bar Chart -->
                    <div class="row g-3 mb-4">
                        <div class="col-lg-3">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-pie-chart text-info me-1"/> Comisiones</h6>
                                </div>
                                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:200px">
                                    <canvas t-ref="chartCommissions" style="max-height:180px;width:100%"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-pie-chart text-secondary me-1"/> Inventario</h6>
                                </div>
                                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:200px">
                                    <canvas t-ref="chartInventory" style="max-height:180px;width:100%"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-bar-chart text-primary me-1"/> Ventas Mensuales</h6>
                                    <button class="btn btn-sm btn-outline-primary" t-on-click="openSaleOrders">Ver todo</button>
                                </div>
                                <div class="card-body" style="min-height:200px">
                                    <canvas t-ref="chartSales" style="height:180px;width:100%"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mini KPI Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openFinancing">
                                <i class="fa fa-credit-card fa-lg text-warning mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.fin_chart and state.data.fin_chart.values[0] or 0"/></h5>
                                <small class="text-muted">Aprobados</small>
                            </div>
                        </div>
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openCommissions">
                                <i class="fa fa-money fa-lg text-info mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.total_commissions"/></h5>
                                <small class="text-muted">Comisiones</small>
                            </div>
                        </div>
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openLeads">
                                <i class="fa fa-users fa-lg text-purple mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.total_leads"/></h5>
                                <small class="text-muted">Oportunidades</small>
                            </div>
                        </div>
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openService">
                                <i class="fa fa-wrench fa-lg text-danger mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.service_orders"/></h5>
                                <small class="text-muted">Servicios</small>
                            </div>
                        </div>
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openInventory">
                                <i class="fa fa-archive fa-lg text-success mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.inventory_movements"/></h5>
                                <small class="text-muted">Movimientos</small>
                            </div>
                        </div>
                        <div class="col-xl-2 col-md-4 col-6">
                            <div class="card border-0 shadow-sm o_kpi_mini_card text-center py-3" t-on-click="openPurchaseOrders">
                                <i class="fa fa-truck fa-lg text-primary mb-2"/>
                                <h5 class="mb-0 fw-bold"><t t-esc="state.data.total_purchase_orders"/></h5>
                                <small class="text-muted">Compras</small>
                            </div>
                        </div>
                    </div>

                    <!-- Tables Row -->
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-shopping-cart me-2 text-success"/> Últimas Ventas</h6>
                                    <button class="btn btn-sm btn-outline-primary" t-on-click="openSaleOrders">Ver todo</button>
                                </div>
                                <div class="card-body p-0 table-responsive" style="overflow-x: auto;">
                                    <table class="table table-hover mb-0 align-middle" style="min-width: 420px;">
                                        <thead class="table-light"><tr><th>Orden</th><th>Cliente</th><th>Total</th><th>Estado</th></tr></thead>
                                        <tbody>
                                            <t t-foreach="state.data.recent_orders || []" t-as="order" t-key="order.id">
                                                <tr>
                                                    <td class="fw-semibold text-nowrap"><t t-esc="order.name"/></td>
                                                    <td class="text-nowrap"><t t-esc="order.partner_id and order.partner_id[1] or ''"/></td>
                                                    <td class="text-nowrap"><t t-esc="order.amount_total"/> <t t-esc="state.data.currency"/></td>
                                                    <td class="text-nowrap">
                                                        <t t-if="order.state == 'sale'"><span class="badge bg-success">Confirmada</span></t>
                                                        <t t-elif="order.state == 'draft'"><span class="badge bg-warning text-dark">Cotización</span></t>
                                                        <t t-else=""><span class="badge bg-secondary" t-esc="order.state"/></t>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="!(state.data.recent_orders || []).length">
                                                <tr><td colspan="4" class="text-center text-muted py-3"><i class="fa fa-inbox me-2"/>Sin órdenes recientes</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                                    <h6 class="mb-0 fw-bold"><i class="fa fa-truck me-2 text-primary"/> Últimas Compras</h6>
                                    <button class="btn btn-sm btn-outline-primary" t-on-click="openPurchaseOrders">Ver todo</button>
                                </div>
                                <div class="card-body p-0 table-responsive" style="overflow-x: auto;">
                                    <table class="table table-hover mb-0 align-middle" style="min-width: 420px;">
                                        <thead class="table-light"><tr><th>Orden</th><th>Proveedor</th><th>Total</th><th>Estado</th></tr></thead>
                                        <tbody>
                                            <t t-foreach="state.data.recent_purchases || []" t-as="po" t-key="po.id">
                                                <tr>
                                                    <td class="fw-semibold text-nowrap"><t t-esc="po.name"/></td>
                                                    <td class="text-nowrap"><t t-esc="po.partner_id and po.partner_id[1] or ''"/></td>
                                                    <td class="text-nowrap"><t t-esc="po.amount_total"/> <t t-esc="state.data.currency"/></td>
                                                    <td class="text-nowrap">
                                                        <t t-if="po.state == 'purchase'"><span class="badge bg-success">Compra</span></t>
                                                        <t t-elif="po.state == 'draft'"><span class="badge bg-warning text-dark">Borrador</span></t>
                                                        <t t-else=""><span class="badge bg-secondary" t-esc="po.state"/></t>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="!(state.data.recent_purchases || []).length">
                                                <tr><td colspan="4" class="text-center text-muted py-3"><i class="fa fa-inbox me-2"/>Sin compras recientes</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
