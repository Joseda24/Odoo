<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_order_form_inherit_nexo" model="ir.ui.view">
    <field name="name">sale.order.nexo.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="vehicle_id"/>
        <field name="vehicle_vin"/>
        <field name="salesperson_id"/>
        <field name="payment_method"/>
        <field name="delivery_date"/>
        <field name="validity_days"/>
        <field name="quotation"/>
      </field>
    </field>
  </record>

  <record id="view_sale_order_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">sale.order.kanban.nexo.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="default_group_by">state</attribute>
      </kanban>
      <div class="d-flex align-items-baseline mb-2" position="after">
        <field name="vehicle_id" class="text-muted small"/>
      </div>
    </field>
  </record>
</odoo>
