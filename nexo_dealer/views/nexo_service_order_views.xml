<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_repair_order_form_inherit_nexo" model="ir.ui.view">
    <field name="name">repair.order.nexo.inherit</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="odometer_in"/>
        <field name="odometer_out"/>
        <field name="priority"/>
      </field>
    </field>
  </record>

  <record id="view_repair_order_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">repair.order.kanban.nexo.inherit</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_kanban"/>
    <field name="arch" type="xml">
      <progressbar position="attributes">
        <attribute name="field">state</attribute>
        <attribute name="colors">{&quot;draft&quot;:&quot;secondary&quot;,&quot;confirmed&quot;:&quot;info&quot;,&quot;under_repair&quot;:&quot;warning&quot;,&quot;ready&quot;:&quot;success&quot;,&quot;done&quot;:&quot;muted&quot;,&quot;cancel&quot;:&quot;danger&quot;}</attribute>
      </progressbar>
      <xpath expr="//div[hasclass('col-6')][2]" position="after">
        <div class="col-12 mt-1 text-muted small">
          <field name="user_id" widget="many2one_avatar_user" class="me-2"/>
          <field name="schedule_date" widget="remaining_days"/>
        </div>
      </xpath>
    </field>
  </record>

  <record id="view_repair_order_graph_nexo" model="ir.ui.view">
    <field name="name">repair.order.graph.nexo</field>
    <field name="model">repair.order</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">
      <graph string="\u00d3rdenes de Servicio por Estado" sample="1" type="bar" stacked="1">
        <field name="create_date" interval="month"/>
        <field name="state"/>
      </graph>
    </field>
  </record>

  <record id="view_repair_order_pivot_nexo" model="ir.ui.view">
    <field name="name">repair.order.pivot.nexo</field>
    <field name="model">repair.order</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">
      <pivot string="\u00d3rdenes de Servicio" sample="1" default_order="state asc">
        <field name="state" type="row"/>
        <field name="user_id" type="row"/>
        <field name="create_date" interval="month" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_repair_order_search_inherit_nexo" model="ir.ui.view">
    <field name="name">repair.order.search.nexo.inherit</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
    <field name="arch" type="xml">
      <filter name="status" position="after">
        <filter name="group_user" string="Mec\u00e1nico" context="{'group_by':'user_id'}"/>
      </filter>
      <field name="sale_order_id" position="after">
        <field name="user_id"/>
        <field name="schedule_date"/>
      </field>
    </field>
  </record>

  <record id="action_nexo_vehicle_service_order" model="ir.actions.act_window">
    <field name="name">\u00d3rdenes de servicio</field>
    <field name="res_model">repair.order</field>
    <field name="view_mode">list,kanban,form,calendar,graph,pivot</field>
  </record>
</odoo>
