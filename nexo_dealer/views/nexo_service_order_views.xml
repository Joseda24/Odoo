<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_repair_order_form_inherit_nexo" model="ir.ui.view">
    <field name="name">repair.order.nexo.inherit</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="odometer_in"/>
        <field name="odometer_out"/>
        <field name="priority"/>
      </field>
    </field>
  </record>

  <record id="view_repair_order_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">repair.order.kanban.nexo.inherit</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_kanban"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="default_group_by">state</attribute>
      </kanban>
    </field>
  </record>

  <record id="action_nexo_vehicle_service_order" model="ir.actions.act_window">
    <field name="name">Órdenes de servicio</field>
    <field name="res_model">repair.order</field>
    <field name="view_mode">list,kanban,form,calendar</field>
  </record>
</odoo>
