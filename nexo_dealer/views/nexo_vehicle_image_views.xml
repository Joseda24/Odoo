<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_vehicle_image_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.image.form</field>
    <field name="model">nexo.vehicle.image</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="image" widget="image"/>
            <field name="sequence"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
