<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_fleet_vehicle_form_inherit_nexo" model="ir.ui.view">
    <field name="name">fleet.vehicle.nexo.inherit</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
    <field name="arch" type="xml">
      <field name="transmission" position="after">
        <field name="engine"/>
        <field name="model_year"/>
      </field>
      <field name="driver_id" position="after">
        <field name="vehicle_status"/>
        <field name="sale_price"/>
        <field name="cost_price"/>
        <field name="location"/>
        <field name="warranty_expiry"/>
      </field>
    </field>
  </record>

  <record id="view_fleet_vehicle_list_inherit_nexo" model="ir.ui.view">
    <field name="name">fleet.vehicle.nexo.list.inherit</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
    <field name="arch" type="xml">
      <field name="license_plate" position="after">
        <field name="vehicle_status"/>
        <field name="sale_price"/>
      </field>
    </field>
  </record>

  <record id="view_fleet_vehicle_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">fleet.vehicle.nexo.kanban.inherit</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="default_group_by">vehicle_status</attribute>
      </kanban>
    </field>
  </record>

  <record id="view_fleet_vehicle_search_inherit_nexo" model="ir.ui.view">
    <field name="name">fleet.vehicle.nexo.search.inherit</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="vehicle_status"/>
        <filter name="nexo_available" string="Disponibles" domain="[('vehicle_status','=','available')]"/>
        <filter name="nexo_sold" string="Vendidos" domain="[('vehicle_status','=','sold')]"/>
        <filter name="nexo_in_service" string="En servicio" domain="[('vehicle_status','=','in_service')]"/>
      </field>
    </field>
  </record>

  <record id="action_nexo_vehicle" model="ir.actions.act_window">
    <field name="name">Vehículos</field>
    <field name="res_model">fleet.vehicle</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{&quot;default_group_by&quot;: &quot;vehicle_status&quot;}</field>
  </record>
</odoo>
