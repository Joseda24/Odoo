<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_test_drive_calendar" model="ir.ui.view">
    <field name="name">nexo.vehicle.test.drive.calendar</field>
    <field name="model">nexo.vehicle.test.drive</field>
    <field name="arch" type="xml">
      <calendar date_start="date_hour" string="Pruebas de manejo" color="state">
        <field name="partner_id"/>
        <field name="vehicle_id"/>
        <field name="salesperson_id"/>
      </calendar>
    </field>
  </record>

  <record id="view_nexo_service_order_calendar" model="ir.ui.view">
    <field name="name">nexo.vehicle.service.order.calendar</field>
    <field name="model">nexo.vehicle.service.order</field>
    <field name="arch" type="xml">
      <calendar date_start="date_in" string="Órdenes de servicio" color="state">
        <field name="partner_id"/>
        <field name="vehicle_id"/>
        <field name="mechanic_id"/>
      </calendar>
    </field>
  </record>
</odoo>
