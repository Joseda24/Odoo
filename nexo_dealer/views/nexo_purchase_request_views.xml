<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_purchase_request_list" model="ir.ui.view">
    <field name="name">nexo.purchase.request.list</field>
    <field name="model">nexo.purchase.request</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="date"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_purchase_request_kanban" model="ir.ui.view">
    <field name="name">nexo.purchase.request.kanban</field>
    <field name="model">nexo.purchase.request</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" class="o_kanban_mobile">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="date"/>
        <field name="state"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="o_kanban_card_header">
                <div class="o_kanban_card_title">
                  <field name="name"/>
                </div>
                <div class="o_kanban_card_subtitle">
                  <field name="partner_id"/>
                </div>
              </div>
              <div class="o_kanban_card_content">
                <div class="row">
                  <div class="col-6">
                    <strong>Fecha:</strong>
                    <field name="date"/>
                  </div>
                  <div class="col-6">
                    <strong>Estado:</strong>
                    <field name="state" widget="badge"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_nexo_purchase_request_graph" model="ir.ui.view">
    <field name="name">nexo.purchase.request.graph</field>
    <field name="model">nexo.purchase.request</field>
    <field name="arch" type="xml">
      <graph string="Solicitudes de Presupuesto" sample="1" type="pie">
        <field name="state"/>
      </graph>
    </field>
  </record>

  <record id="view_nexo_purchase_request_pivot" model="ir.ui.view">
    <field name="name">nexo.purchase.request.pivot</field>
    <field name="model">nexo.purchase.request</field>
    <field name="arch" type="xml">
      <pivot string="Solicitudes de Presupuesto" display_quantity="1" sample="1">
        <field name="date" interval="month" type="row"/>
        <field name="partner_id" type="row"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_nexo_purchase_request_form" model="ir.ui.view">
    <field name="name">nexo.purchase.request.form</field>
    <field name="model">nexo.purchase.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_send" string="Enviar" type="object" invisible="state != 'draft'"/>
          <button name="action_receive" string="Recibir respuesta" type="object" invisible="state != 'sent'"/>
          <button name="action_create_order" string="Crear orden de compra" type="object" invisible="state != 'received'" class="btn-primary"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <h1><field name="name"/></h1>
          <group>
            <field name="partner_id"/>
            <field name="date"/>
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="product_id"/>
              <field name="vehicle_id"/>
              <field name="description"/>
              <field name="quantity"/>
              <field name="price_unit"/>
            </list>
          </field>
          <field name="notes"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_nexo_purchase_request" model="ir.actions.act_window">
    <field name="name">Solicitudes (RFQ)</field>
    <field name="res_model">nexo.purchase.request</field>
    <field name="view_mode">list,form,kanban,graph,pivot</field>
  </record>
</odoo>
