<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_part_form" model="ir.ui.view">
    <field name="name">nexo.part.form</field>
    <field name="model">nexo.part</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="barcode"/>
              <field name="category"/>
              <field name="location"/>
              <field name="supplier_id"/>
            </group>
            <group>
              <field name="stock"/>
              <field name="min_stock" widget="integer"/>
              <field name="cost_price"/>
              <field name="sale_price"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_nexo_part_list" model="ir.ui.view">
    <field name="name">nexo.part.list</field>
    <field name="model">nexo.part</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="category"/>
        <field name="stock"/>
        <field name="min_stock"/>
        <field name="cost_price"/>
        <field name="sale_price"/>
        <field name="supplier_id"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_part_search" model="ir.ui.view">
    <field name="name">nexo.part.search</field>
    <field name="model">nexo.part</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="barcode"/>
        <field name="category"/>
        <filter string="Stock bajo" name="low_stock" domain="[('stock', '&lt;', 'min_stock')]"/>
      </search>
    </field>
  </record>

  <record id="view_nexo_part_move_form" model="ir.ui.view">
    <field name="name">nexo.part.move.form</field>
    <field name="model">nexo.part.move</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="part_id"/>
              <field name="type"/>
              <field name="quantity"/>
            </group>
            <group>
              <field name="date"/>
              <field name="reference"/>
              <field name="service_order_id"/>
            </group>
          </group>
          <group>
            <field name="notes"/>
          </group>
        </sheet>
        <header>
          <button name="action_validate" string="Validar movimiento" type="object" class="btn-primary"/>
        </header>
      </form>
    </field>
  </record>

  <record id="view_nexo_part_move_list" model="ir.ui.view">
    <field name="name">nexo.part.move.list</field>
    <field name="model">nexo.part.move</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="part_id"/>
        <field name="type"/>
        <field name="quantity"/>
        <field name="date"/>
        <field name="reference"/>
        <field name="service_order_id"/>
      </list>
    </field>
  </record>
</odoo>
