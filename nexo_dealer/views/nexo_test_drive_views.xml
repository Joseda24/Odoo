<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_test_drive_kanban" model="ir.ui.view">
    <field name="name">nexo.vehicle.test.drive.kanban</field>
    <field name="model">nexo.vehicle.test.drive</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" group_create="true" quick_create="false">
        <field name="name"/>
        <field name="state"/>
        <field name="vehicle_id"/>
        <field name="partner_id"/>
        <field name="salesperson_id"/>
        <field name="date_hour"/>
        <field name="duration"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_details">
                <div class="o_kanban_record_title">
                  <field name="name"/>
                </div>
                <div class="o_kanban_record_subtitle">
                  <field name="vehicle_id"/> - <field name="partner_id"/>
                </div>
                <div class="o_kanban_record_bottom">
                  <field name="date_hour"/>
                  <field name="state" widget="badge"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_nexo_test_drive_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.test.drive.list</field>
    <field name="model">nexo.vehicle.test.drive</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date_hour"/>
        <field name="partner_id"/>
        <field name="vehicle_id"/>
        <field name="salesperson_id"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_test_drive_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.test.drive.form</field>
    <field name="model">nexo.vehicle.test.drive</field>
    <field name="arch" type="xml">
      <form>
        <field name="state" widget="statusbar"/>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="vehicle_id"/>
            <field name="partner_id"/>
            <field name="salesperson_id"/>
            <field name="date_hour"/>
            <field name="duration"/>
          </group>
          <group string="Notas">
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
