<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_purchase_order_form_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.nexo.inherit</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="vehicle_reception_ids"/>
      </field>
    </field>
  </record>

  <record id="view_purchase_order_line_form_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.line.nexo.inherit</field>
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="vehicle_id"/>
      </field>
    </field>
  </record>

  <record id="view_purchase_order_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.kanban.nexo.inherit</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.view_purchase_order_kanban"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="default_group_by">state</attribute>
      </kanban>
    </field>
  </record>

  <record id="action_nexo_purchase_request" model="ir.actions.act_window">
    <field name="name">Solicitudes (RFQ)</field>
    <field name="res_model">nexo.purchase.request</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
