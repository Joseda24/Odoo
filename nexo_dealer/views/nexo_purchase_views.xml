<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_purchase_order_form_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.nexo.inherit</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="vehicle_reception_ids"/>
      </field>
    </field>
  </record>

  <record id="view_purchase_order_line_form_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.line.nexo.inherit</field>
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="vehicle_id"/>
      </field>
    </field>
  </record>

  <record id="view_purchase_order_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">purchase.order.kanban.nexo.inherit</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.view_purchase_order_kanban"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="default_group_by">state</attribute>
      </kanban>
    </field>
  </record>

  <record id="view_purchase_order_graph_nexo" model="ir.ui.view">
    <field name="name">purchase.order.graph.nexo</field>
    <field name="model">purchase.order</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <graph string="Órdenes de Compra" sample="1" type="bar" stacked="1">
        <field name="partner_id"/>
        <field name="state"/>
        <field name="amount_total" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_purchase_order_pivot_nexo" model="ir.ui.view">
    <field name="name">purchase.order.pivot.nexo</field>
    <field name="model">purchase.order</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <pivot string="Órdenes de Compra" display_quantity="1" sample="1">
        <field name="date_order" interval="month" type="row"/>
        <field name="partner_id" type="row"/>
        <field name="state" type="col"/>
        <field name="amount_total" type="measure"/>
      </pivot>
    </field>
  </record>

</odoo>
