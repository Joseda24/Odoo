<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_fleet_vehicle_model_form_inherit_nexo" model="ir.ui.view">
    <field name="name">fleet.vehicle.model.nexo.inherit</field>
    <field name="model">fleet.vehicle.model</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
    <field name="arch" type="xml">
      <field name="category_id" position="after">
        <field name="year_from"/>
        <field name="year_to"/>
        <field name="vehicle_type"/>
      </field>
    </field>
  </record>
  <record id="action_nexo_vehicle_model" model="ir.actions.act_window">
    <field name="name">Modelos</field>
    <field name="res_model">fleet.vehicle.model</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
