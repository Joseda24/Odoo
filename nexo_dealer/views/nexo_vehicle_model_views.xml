<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_vehicle_model_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.model.list</field>
    <field name="model">nexo.vehicle.model</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="brand_id"/>
        <field name="vehicle_type"/>
        <field name="year_from"/>
        <field name="year_to"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_vehicle_model_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.model.form</field>
    <field name="model">nexo.vehicle.model</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="brand_id"/>
            <field name="vehicle_type"/>
            <field name="year_from"/>
            <field name="year_to"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
