<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_vehicle_inventory_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.inventory.list</field>
    <field name="model">nexo.vehicle.inventory</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="vehicle_id"/>
        <field name="date_in"/>
        <field name="type"/>
        <field name="cost"/>
        <field name="supplier_id"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_vehicle_inventory_kanban" model="ir.ui.view">
    <field name="name">nexo.vehicle.inventory.kanban</field>
    <field name="model">nexo.vehicle.inventory</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="name"/>
        <field name="state"/>
        <field name="vehicle_id"/>
        <templates>
          <t t-name="kanban-card">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_details">
                <strong><field name="name"/></strong>
                <div><field name="vehicle_id"/></div>
                <div><field name="date_in"/></div>
                <div><field name="cost"/></div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_nexo_vehicle_inventory_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.inventory.form</field>
    <field name="model">nexo.vehicle.inventory</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_done" string="Registrar ingreso" type="object" invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_cancel" string="Cancelar" type="object" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="vehicle_id"/>
              <field name="date_in"/>
              <field name="type"/>
              <field name="cost"/>
            </group>
            <group>
              <field name="supplier_id"/>
              <field name="purchase_order_id"/>
              <field name="notes"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_nexo_vehicle_inventory" model="ir.actions.act_window">
    <field name="name">Inventario</field>
    <field name="res_model">nexo.vehicle.inventory</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{&quot;default_group_by&quot;: &quot;state&quot;}</field>
  </record>
</odoo>