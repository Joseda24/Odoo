<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_vehicle_inventory_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.inventory.list</field>
    <field name="model">nexo.vehicle.inventory</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="vehicle_id"/>
        <field name="date_in"/>
        <field name="type"/>
        <field name="cost"/>
        <field name="supplier_id"/>
        <field name="purchase_order_id"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_vehicle_inventory_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.inventory.form</field>
    <field name="model">nexo.vehicle.inventory</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_done" string="Registrar ingreso" type="object" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_cancel" string="Cancelar" type="object"
                  invisible="state != 'draft'"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="vehicle_id"/>
              <field name="type"/>
              <field name="date_in"/>
            </group>
            <group>
              <field name="cost"/>
              <field name="supplier_id"/>
              <field name="purchase_order_id"/>
            </group>
          </group>
          <group>
            <field name="notes"/>
          </group>
          <field name="state" widget="statusbar"/>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
