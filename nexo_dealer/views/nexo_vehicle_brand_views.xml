<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_vehicle_brand_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.brand.list</field>
    <field name="model">nexo.vehicle.brand</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="model_ids"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_vehicle_brand_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.brand.form</field>
    <field name="model">nexo.vehicle.brand</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="logo" widget="image"/>
          </group>
          <field name="model_ids">
            <list>
              <field name="name"/>
              <field name="vehicle_type"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
