<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_crm_lead_form_inherit_nexo" model="ir.ui.view">
    <field name="name">crm.lead.nexo.inherit</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="vehicle_id"/>
        <field name="source"/>
      </field>
    </field>
  </record>

  <record id="view_crm_lead_kanban_inherit_nexo" model="ir.ui.view">
    <field name="name">crm.lead.kanban.nexo.inherit</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="before">
        <div class="mb-1">
          <field name="vehicle_id" options="{'no_create': True}" class="d-block small"/>
          <field name="source" class="text-muted small"/>
        </div>
      </field>
    </field>
  </record>

  <record id="action_nexo_lead" model="ir.actions.act_window">
    <field name="name">Leads / Oportunidades</field>
    <field name="res_model">crm.lead</field>
    <field name="view_mode">kanban,list,form</field>
  </record>
</odoo>
