<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_employee_form_inherit_nexo" model="ir.ui.view">
    <field name="name">hr.employee.nexo.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <field name="job_title" position="after">
        <field name="nexo_position"/>
        <field name="nexo_code"/>
        <field name="nexo_commission_type"/>
        <field name="nexo_commission_rate"/>
        <field name="nexo_fixed_commission"/>
      </field>
    </field>
  </record>

  <record id="action_nexo_employee" model="ir.actions.act_window">
    <field name="name">Empleados</field>
    <field name="res_model">hr.employee</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_nexo_commission" model="ir.actions.act_window">
    <field name="name">Comisiones</field>
    <field name="res_model">nexo.commission</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
