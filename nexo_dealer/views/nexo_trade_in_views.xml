<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_nexo_trade_in_kanban" model="ir.ui.view">
    <field name="name">nexo.vehicle.trade_in.kanban</field>
    <field name="model">nexo.vehicle.trade_in</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" group_create="true" quick_create="false">
        <field name="name"/>
        <field name="state"/>
        <field name="condition"/>
        <field name="incoming_vehicle_id"/>
        <field name="partner_id"/>
        <field name="date"/>
        <field name="agreed_value"/>
        <field name="market_value"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_details">
                <div class="o_kanban_record_title">
                  <field name="name"/>
                </div>
                <div class="o_kanban_record_subtitle">
                  <field name="incoming_vehicle_id"/> - <field name="partner_id"/>
                </div>
                <div class="o_kanban_record_bottom">
                  <field name="agreed_value"/>
                  <field name="state" widget="badge"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_nexo_trade_in_list" model="ir.ui.view">
    <field name="name">nexo.vehicle.trade_in.list</field>
    <field name="model">nexo.vehicle.trade_in</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="incoming_vehicle_id"/>
        <field name="condition"/>
        <field name="agreed_value"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_nexo_trade_in_form" model="ir.ui.view">
    <field name="name">nexo.vehicle.trade_in.form</field>
    <field name="model">nexo.vehicle.trade_in</field>
    <field name="arch" type="xml">
      <form>
        <field name="state" widget="statusbar"/>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <field name="incoming_vehicle_id"/>
            <field name="partner_id"/>
            <field name="sale_order_id"/>
            <field name="date"/>
            <field name="condition"/>
          </group>
          <group string="Valores">
            <field name="market_value"/>
            <field name="agreed_value"/>
          </group>
          <group string="Notas">
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
