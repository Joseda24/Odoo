<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_nexo_sale_order">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Pedido de Venta</h2>
            <div class="row">
              <div class="col-6">
                <strong>Folio:</strong> <span t-field="doc.name"/><br/>
                <strong>Fecha:</strong> <span t-field="doc.date_order"/><br/>
                <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/><br/>
                <strong>Vendedor:</strong> <span t-field="doc.salesperson_id.name"/><br/>
                <t t-if="doc.vehicle_id">
                  <strong>Vehículo:</strong> <span t-field="doc.vehicle_id.name"/><br/>
                  <strong>VIN:</strong> <span t-field="doc.vehicle_id.vin"/><br/>
                </t>
                <t t-if="doc.delivery_date">
                  <strong>Entrega:</strong> <span t-field="doc.delivery_date"/><br/>
                </t>
                <strong>Pago:</strong> <span t-field="doc.payment_method"/>
              </div>
            </div>
            <table class="table table-sm mt-3">
              <thead><tr><th>Producto</th><th>Cant.</th><th>P. Unitario</th><th>Subtotal</th></tr></thead>
              <tbody>
                <tr t-foreach="doc.line_ids" t-as="line">
                  <td><span t-field="line.description"/></td>
                  <td><span t-field="line.quantity"/></td>
                  <td><span t-field="line.price_unit"/></td>
                  <td><span t-field="line.price_subtotal"/></td>
                </tr>
              </tbody>
            </table>
            <div class="row">
              <div class="col-6 offset-6">
                <table class="table table-sm">
                  <tr><td><strong>Subtotal</strong></td><td class="text-right"><span t-field="doc.amount_subtotal"/></td></tr>
                  <tr><td><strong>Impuestos</strong></td><td class="text-right"><span t-field="doc.amount_tax"/></td></tr>
                  <tr><td><strong>Total</strong></td><td class="text-right"><span t-field="doc.amount_total"/></td></tr>
                </table>
              </div>
            </div>
            <p t-if="doc.notes"><strong>Notas:</strong><br/><span t-field="doc.notes"/></p>
          </div>
        </t>
      </t>
    </t>
  </template>

  <record id="report_action_nexo_sale_order" model="ir.actions.report">
    <field name="name">Pedido de Venta</field>
    <field name="model">nexo.sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">nexo_dealer.report_nexo_sale_order</field>
    <field name="report_file">nexo_dealer.report_nexo_sale_order</field>
    <field name="binding_model_id" ref="model_nexo_sale_order"/>
    <field name="binding_type">report</field>
  </record>
</odoo>
